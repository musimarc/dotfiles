#!/usr/bin/env bash
# Recherche de fichier PAR NOM via wofi (GUI). wofi filtre lui-même la liste.
# Usage : file-find-wofi [dossier]  (défaut : ~)
cd "${1:-$HOME}" || exit 1
file=$(rg --files --hidden --glob '!.git' 2>/dev/null \
        | wofi --dmenu --prompt "Fichier" --insensitive --matching fuzzy) || exit 0
[ -n "$file" ] && xdg-open "$file"
