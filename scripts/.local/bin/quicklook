#!/usr/bin/env bash
set -euo pipefail

file=${1:?Usage: quicklook FILE}
thunar_con_id=$(swaymsg -t get_tree | python3 -c '
import json, sys

def find_focused_thunar(node):
    if node.get("app_id") == "thunar" and node.get("focused"):
        return node.get("id")
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        result = find_focused_thunar(child)
        if result is not None:
            return result

tree = json.load(sys.stdin)
print(find_focused_thunar(tree) or "")
')

version=$(swayimg --version 2>/dev/null | sed -nE 's/^swayimg version ([0-9]+)\.([0-9]+).*/\1 \2/p')
if [[ -z $version ]]; then
	notify-send --urgency=critical "Aperçu photo" "Version de Swayimg illisible. Swayimg 5.5 ou plus est requis."
	exit 1
fi
read -r version_major version_minor <<<"$version"
if ((version_major < 5 || (version_major == 5 && version_minor < 5))); then
	notify-send --urgency=critical "Aperçu photo" "Swayimg 5.5 ou plus est requis pour les actions Lua sûres."
	exit 1
fi

if [[ ! $thunar_con_id =~ ^[0-9]+$ ]]; then
	thunar_con_id=
fi

export QUICKLOOK_THUNAR_CON_ID=$thunar_con_id
exec swayimg --config="$HOME/.local/share/swayimg/quicklook.lua" "$file"
