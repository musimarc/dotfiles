#!/usr/bin/env bash
# Luminosité + notification mako : icône selon le niveau + barre de progression.
case "$1" in
  up)   brightnessctl set +10% >/dev/null ;;
  down) brightnessctl set 10%- >/dev/null ;;
esac

pct=$(brightnessctl -m | awk -F, '{gsub("%","",$4); print $4}')

if   [ "$pct" -lt 34 ]; then icon=notification-display-brightness-low
elif [ "$pct" -lt 67 ]; then icon=notification-display-brightness-medium
else                         icon=notification-display-brightness-high
fi

notify-send -a brightness -i "$icon" \
  -h "int:value:$pct" \
  -h "string:x-canonical-private-synchronous:brightness" \
  "Luminosité" "${pct}%"
