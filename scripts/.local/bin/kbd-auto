#!/usr/bin/env bash
# Rétroéclairage clavier auto jour/nuit, calé sur le soleil de Le Crès
# -> synchronisé avec le night light (mêmes coordonnées / même bascule au coucher).
#  - "kbd-auto"        : applique seulement si le jour/nuit a changé (respecte un réglage manuel entre-temps)
#  - "kbd-auto force"  : applique dans tous les cas (utilisé au login)
LAT="43.65"; LON="3.93"     # Le Crès, Hérault (idem nightlight)
NIGHT_LEVEL=1               # niveau de nuit : 0 éteint / 1 faible / 2 fort
DEV="tpacpi::kbd_backlight"
STATE="${XDG_RUNTIME_DIR:-/tmp}/kbd-auto.state"   # tmpfs -> remis à zéro à chaque session

phase=$(python3 - "$LAT" "$LON" <<'PY'
import math, datetime, sys
lat, lon = float(sys.argv[1]), float(sys.argv[2])
now = datetime.datetime.now(datetime.timezone.utc)
n = now.timetuple().tm_yday
hour = now.hour + now.minute/60 + now.second/3600
decl = -23.44*math.cos(math.radians(360/365*(n+10)))
H = 15*((hour + lon/15.0) - 12)
alt = math.degrees(math.asin(math.sin(math.radians(lat))*math.sin(math.radians(decl)) +
      math.cos(math.radians(lat))*math.cos(math.radians(decl))*math.cos(math.radians(H))))
print("night" if alt < 0 else "day")
PY
)

# Sans "force", on n'agit qu'au changement jour<->nuit (pour ne pas écraser un réglage manuel)
if [ "${1:-}" != "force" ] && [ "$phase" = "$(cat "$STATE" 2>/dev/null)" ]; then
    exit 0
fi

if [ "$phase" = "night" ]; then
    brightnessctl -d "$DEV" set "$NIGHT_LEVEL" >/dev/null && echo "$phase" > "$STATE"
else
    brightnessctl -d "$DEV" set 0 >/dev/null && echo "$phase" > "$STATE"
fi
